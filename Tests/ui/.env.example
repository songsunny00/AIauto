# 复制此文件为 .env 并填入实际值
# .env 已在 .gitignore 中忽略，不会入库

# 测试环境地址（示例：本地服务）
TEST_BASE_URL=http://localhost:7001

# 测试账号（admin 角色，菜单权限需含 menuId=11013）
TEST_USERNAME=your-username
TEST_PASSWORD=your-password

# 浏览器 channel：
#   留空      -> 使用 Playwright 自带 chromium（需先执行 npm run test:install）
#   msedge    -> 使用系统 Microsoft Edge（无需额外下载浏览器）
#   chrome    -> 使用系统 Google Chrome
PW_BROWSER_CHANNEL=msedge
