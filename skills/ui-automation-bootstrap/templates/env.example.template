# UI 自动化测试环境变量（复制为 .env 并填入实际值）
# 位置：Tests/.env（依赖与 .env 均上提到 Tests/ 级，单一来源；ui-automation 下不再放 .env）

# 测试环境前端地址（环境标识，用于登录页构造与报告标注）
TEST_BASE_URL=http://localhost:7001

# 测试账号
TEST_USERNAME=your_username
TEST_PASSWORD=your_password

# 项目级默认一级模块与登录态校验页
# 作用：global-setup.ts 在独立运行（如 npm run auth:capture，无 run.mjs 注入）时的回退值
# DEFAULT_DOMAIN：一级模块目录名，如 CONFIG-配置中心
# DEFAULT_AUTH_PATH：登录后校验页路径，如 /config/billingConfig
DEFAULT_DOMAIN=CONFIG-配置中心
DEFAULT_AUTH_PATH=/config/billingConfig

# 浏览器 channel（可选）：留空=自带 chromium；msedge/chrome=系统浏览器
# PW_BROWSER_CHANNEL=msedge

# AI 报告生成（可选，gen-report.mjs --ai 时使用；不配则回退机械报告 + AI Agent 生成）
# AI_REPORT_BASE_URL=https://api.example.com/v1
# AI_REPORT_API_KEY=sk-xxx
# AI_REPORT_MODEL=gpt-4o-mini
